# ── Supabase ──────────────────────────────────────────────
# Publishable key = the anon key (safe for frontend, respects RLS)
# Secret key = the service_role key (for your backend, bypasses RLS)
SUPABASE_URL=<>
SUPABASE_PUBLISHABLE_KEY=<>
SUPABASE_SECRET_KEY=<>

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM Configuration (Automatically maps to Settings.llm)
EMBEDDING_PROVIDER=openai       
# EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=<>

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=<>
# LLM_TEMPERATURE=0.7

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20240620
# LLM_API_KEY=sk-ant-your-anthropic-key
# LLM_MAX_TOKENS=4096

# # Local Ollama
# # No base_url or api_key needed; your Pydantic validator automatically 
# # sets the base_url to http://localhost:11434!
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3

## Remote Ollama
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:27b
LLM_BASE_URL=https://primehub.aic.ncku.edu.tw/console/apps/ollama-0-13-4-fbxwp/v1
## Openrouter
## No base_url needed; your Pydantic validator sets it to the OpenRouter default.
# LLM_PROVIDER=openrouter
# LLM_MODEL=anthropic/claude-3.5-sonnet
# LLM_API_KEY=sk-or-v1-your-openrouter-key


# ── App ───────────────────────────────────────────────────
DEBUG=false
AGENT_STATUS_TTL=300
# .env for local dev — file next to where you run uvicorn
LOG_FILE_PATH=app.log
# .env for Docker/cloud — disable file entirely, let stdout be captured
# In Docker we don't want file logging — the container's filesystem is ephemeral 
# and cloud providers (GCP, AWS) capture stdout automatically. 
# LOG_FILE_PATH=

# ── Langgraph ───────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<>