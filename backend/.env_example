# --------------------------------------------------------------
# Mewi backend environment example
#
# Copy this file to `.env` for local development and replace placeholder
# values with real credentials. Do not commit your real `.env`.
# --------------------------------------------------------------

# -- App runtime ------------------------------------------------
ENV=development
DEBUG=false
LOG_LEVEL=INFO
# LOG_FILE_PATH=app.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3

# Used by FastAPI API-key auth. Unity must send this as `X-API-Key`.
API_SECRET_TOKEN=dev-secret-change-me

# Railway/Fly/etc may inject PORT. Uvicorn defaults to 8000 in Procfile.
# PORT=8000

# -- Supabase ---------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_TIMEOUT=10

# -- Redis ------------------------------------------------------
# Local docker-compose default:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Prefer REDIS_URL in hosted environments or when Docker networking needs it.
# Examples:
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0
# REDIS_URL=rediss://default:password@host:6379/0
# REDIS_URL=

# -- Unity bridge -----------------------------------------------
# Used by backend-side live tests / optional backend-to-Unity action transport.
UNITY_BRIDGE_URL=http://localhost:8080
UNITY_TRANSPORT=http

# -- LLM provider -----------------------------------------------
# Supported: openai, anthropic, ollama, openrouter, groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo
LLM_API_KEY=your-llm-api-key
# Leave blank for provider defaults. Examples:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# Optional fallback for services that use OpenAI-compatible APIs directly.
OPENAI_API_KEY=your-openai-api-key

# -- Embeddings -------------------------------------------------
# If EMBEDDING_API_KEY is empty, the backend falls back to LLM_API_KEY.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# -- Agent pipeline toggles -------------------------------------
# False: ticks buffer only, no LLM/DB flush.
# True: Redis buffer flushes into semantic summaries + graph decisions.
ENABLE_MEMORY_PIPELINE=false
ENABLE_REFLECTION_CYCLE=false
BUFFER_FLUSH_THRESHOLD=10
AGENT_STATUS_TTL=300

# -- Background worker intervals -------------------------------
AGENT_WORKER_INTERVAL=10
MICROLOG_WORKER_INTERVAL=30

# -- Legacy/optional local Ollama setting -----------------------
# Prefer LLM_PROVIDER=ollama and LLM_BASE_URL above for current code.
OLLAMA_BASE_URL=http://localhost:11434
