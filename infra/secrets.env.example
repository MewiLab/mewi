# Copy this file to `secrets.env` (which is gitignored) and fill in your values.
#   cp secrets.env.example secrets.env
#
# deploy.sh sources secrets.env and exports these. The TF_VAR_ prefix is how
# Terraform picks them up automatically as input variables — do NOT remove it.

# Claude API key — REQUIRED. The report Lambdas' agent runs need it.
# Leave this empty in the template so deploy.sh can catch "not filled in" early.
export TF_VAR_anthropic_api_key=""

# RAGFlow knowledge base — OPTIONAL. Leave empty to disable retrieval; the
# Lambdas then fall back to deterministic copy.
export TF_VAR_ragflow_endpoint=""      # e.g. https://ragflow.example.com
export TF_VAR_ragflow_api_key=""

# Default Claude model — OPTIONAL. Defaults to claude-sonnet-4-6 if unset.
# export TF_VAR_claude_model="claude-sonnet-4-6"

# AWS resource region — OPTIONAL. Defaults to Singapore / ap-southeast-1.
# If you override this, the backend AWS_REGION must match it.
# export TF_VAR_aws_region="ap-southeast-1"

# FastAPI runtime IAM role — OPTIONAL. If FastAPI runs on AWS and Terraform
# should attach the raw-S3 write/list + SQS SendMessage policy, set its role name.
# export TF_VAR_backend_report_sender_role_name="mewi-backend-task-role"
