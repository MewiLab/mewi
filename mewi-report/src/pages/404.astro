---
import Base from '../layouts/Base.astro';
---
<Base title="Mewi · Not found">
  <div style="padding:4rem 0;text-align:center">
    <div class="label" style="margin-bottom:.75rem">404</div>
    <p style="font-family:var(--font-serif);font-size:1.4rem;color:var(--ink);margin-bottom:.75rem">
      The cat has moved on.
    </p>
    <p style="font-size:12px;color:var(--ink3);margin-bottom:1.5rem">
      This report doesn't exist, or hasn't been generated yet.
    </p>
    <a href="/" style="font-size:12px;color:var(--ink2);border-bottom:0.5px solid var(--border-md);padding-bottom:1px">
      ← back to reports
    </a>
  </div>
</Base>
