---
// Generates one static page per local processed data file.

import ReportView from '../../../components/ReportView.astro';
import { createLocalFileReportSource } from '../../../utils/reportSource';
import { isAttachmentReport } from '../../../utils/reportSchema';
import { loadReportRoutes } from '../../../utils/reportRoutes';

export async function getStaticPaths() {
  const routes = await loadReportRoutes();
  return routes.map(route => ({
    params: { userId: route.routeId },
    props: {
      dataFileId: route.dataFileId,
      displayName: route.displayName,
    },
  }));
}

const { userId } = Astro.params;
const dataFileId = Astro.props.dataFileId ?? userId;
const routeDisplayName = Astro.props.displayName as string | undefined;
const report = await createLocalFileReportSource().load(String(dataFileId), 'attachment');

if (!isAttachmentReport(report)) {
  return Astro.redirect('/404');
}
---

<ReportView
  report={report}
  routeUserId={String(userId ?? report.user_id)}
  routeDisplayName={routeDisplayName}
/>
