---
// src/components/SequenceLog.astro
export interface SequenceEvent {
  ts: string;
  actor: 'H' | 'C';
  action: string;
  trigger?: string;
}
export interface Props {
  events: SequenceEvent[];
  catName: string;
  catAccent: string;
}
const { events, catName, catAccent } = Astro.props;
const catNameLower = catName.toLowerCase();
---
<div class="seq-wrap">
  {events.map(ev => (
    <div class="seq-row">
      <span class="seq-ts">{ev.ts}</span>
      {ev.actor === 'H'
        ? <span class="seq-human">human</span>
        : <span class="seq-cat" style={`color:${catAccent}`}>{catNameLower}</span>
      }
      <span class="seq-action">{ev.action}</span>
      {ev.trigger && <span class="seq-trigger">{ev.trigger}</span>}
    </div>
  ))}
</div>

<style>
.seq-wrap {
  border: 0.5px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  font-size: 12px;
}
.seq-row {
  display: grid;
  grid-template-columns: 44px 60px 1fr auto;
  gap: 6px;
  align-items: center;
  padding: .35rem .75rem;
  border-bottom: 0.5px solid var(--border);
  transition: background var(--transition);
}
.seq-row:last-child { border-bottom: none; }
.seq-row:hover { background: var(--bg2); }
.seq-ts    { font-size: 11px; color: var(--ink3); }
.seq-human { color: var(--ink2); }
.seq-action { color: var(--ink2); }
.seq-trigger { font-size: 10px; color: var(--ink3); text-align: right; }
</style>
