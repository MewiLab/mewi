---
// src/components/TrustChart.astro
export interface Props {
  catsJson: string;
  sessionCount: number;
}

const { catsJson, sessionCount } = Astro.props;

type CatData = {
  name?: string;
  accent?: string;
  trust_arc?: number[];
};

function parseCats(raw: string): Record<string, CatData> {
  try {
    const parsed = JSON.parse(raw);
    return typeof parsed === 'object' && parsed !== null ? parsed : {};
  } catch {
    return {};
  }
}

const cats = parseCats(catsJson);
const preferredOrder = ['mewi', 'miso', 'yuzu', 'haru'];
const order = [
  ...preferredOrder.filter(catId => cats[catId]),
  ...Object.keys(cats).filter(catId => !preferredOrder.includes(catId)),
];
const safeSessionCount = Number(sessionCount) || Math.max(1, ...order.map(catId => cats[catId]?.trust_arc?.length ?? 0));
const width = 640;
const height = 250;
const padX = 36;
const padY = 24;
const plotWidth = width - padX * 2;
const plotHeight = height - padY * 2;
const maxTrust = Math.max(45, ...order.flatMap(catId => cats[catId]?.trust_arc ?? []));

function pointFor(value: number, index: number, count: number) {
  const x = padX + (count > 1 ? index * (plotWidth / (count - 1)) : 0);
  const y = height - padY - (Number(value) / maxTrust) * plotHeight;
  return { x, y };
}

function polyline(values: number[] = []) {
  return values.map((value, index) => {
    const { x, y } = pointFor(value, index, values.length);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ');
}
---

<div class="trust-chart">
  {order.length ? (
    <>
      <div class="legend" aria-hidden="true">
        {order.map(catId => {
          const cat = cats[catId] ?? {};
          const last = cat.trust_arc?.at(-1) ?? 0;
          const sign = last >= 0 ? '+' : '';

          return (
            <span class="leg-item">
              <span class="leg-swatch" style={`background:${cat.accent ?? 'var(--ink3)'}`}></span>
              {cat.name ?? catId} ({sign}{last})
            </span>
          );
        })}
      </div>

      <div class="chart-wrap">
        <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Line chart comparing trust score per session for all cats">
          {[0, 15, 30, 45].map(tick => {
            const y = height - padY - (tick / maxTrust) * plotHeight;
            return (
              <g>
                <line x1={padX} y1={y} x2={width - padX} y2={y} class="grid-line" />
                <text x={padX - 10} y={y + 3} text-anchor="end" class="axis-label">{tick}</text>
              </g>
            );
          })}

          {Array.from({ length: safeSessionCount }, (_, index) => {
            const x = padX + (safeSessionCount > 1 ? index * (plotWidth / (safeSessionCount - 1)) : 0);
            return <text x={x} y={height - 6} text-anchor="middle" class="axis-label">S{index + 1}</text>;
          })}

          {order.map(catId => {
            const cat = cats[catId] ?? {};
            const trustArc = cat.trust_arc ?? [];
            const accent = cat.accent ?? 'var(--ink3)';

            return (
              <g>
                <polyline points={polyline(trustArc)} fill="none" stroke={accent} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                {trustArc.map((value, index) => {
                  const { x, y } = pointFor(value, index, trustArc.length);
                  return <circle cx={x} cy={y} r="4" fill={accent} />;
                })}
              </g>
            );
          })}
        </svg>
      </div>
      <p class="chart-caption">Trust comparison chart for all four cats.</p>
    </>
  ) : (
    <p class="chart-caption">No trust comparison data was recorded yet.</p>
  )}
</div>

<style is:global>
.trust-chart .chart-wrap { position: relative; width: 100%; min-height: 240px; }
.trust-chart svg { display: block; width: 100%; height: auto; overflow: visible; }
.trust-chart .grid-line { stroke: var(--border); stroke-width: 1; }
.trust-chart .axis-label { fill: var(--ink3); font-size: 10px; }
.trust-chart .legend {
  display: flex; gap: 16px; flex-wrap: wrap;
  margin-bottom: 8px; font-size: 11px; color: var(--ink2);
}
.trust-chart .leg-item { display: flex; align-items: center; gap: 5px; }
.trust-chart .leg-swatch { display: inline-block; width: 18px; height: 1.5px; }
.trust-chart .chart-caption {
  margin-top: .5rem;
  color: var(--ink3);
  font-size: 11px;
  line-height: 1.5;
}
</style>
