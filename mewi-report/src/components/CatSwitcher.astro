---
// src/components/CatSwitcher.astro
export interface Props {
  catsJson: string;
  sessionCount: number;
}

const { catsJson, sessionCount } = Astro.props;

type CatData = {
  name?: string;
  accent?: string;
  archetype?: string;
  trait?: string;
  trust_arc?: number[];
  delta?: string;
  status?: string;
  bars?: Array<{ label: string; value: number }>;
  moments?: Array<{ session: string; event: string; highlight?: boolean; milestone?: string | null }>;
};

function parseCats(raw: string): Record<string, CatData> {
  try {
    const parsed = JSON.parse(raw);
    return typeof parsed === 'object' && parsed !== null ? parsed : {};
  } catch {
    return {};
  }
}

const cats = parseCats(catsJson);
const preferredOrder = ['mewi', 'miso', 'yuzu', 'haru'];
const order = [
  ...preferredOrder.filter(catId => cats[catId]),
  ...Object.keys(cats).filter(catId => !preferredOrder.includes(catId)),
];
const safeSessionCount = Number(sessionCount) || Math.max(1, ...order.map(catId => cats[catId]?.trust_arc?.length ?? 0));

function trustPoints(values: number[] = []) {
  const width = 260;
  const height = 104;
  const pad = 8;
  const maxValue = Math.max(45, ...values);
  const xStep = values.length > 1 ? (width - pad * 2) / (values.length - 1) : 0;

  return values.map((value, index) => {
    const x = pad + index * xStep;
    const y = height - pad - (Number(value) / maxValue) * (height - pad * 2);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ');
}
---

<div class="cs-root" data-cat-switcher>
  {order.length ? (
    <>
      <div class="cs-tabs" role="tablist" aria-label="Select a cat">
        {order.map((catId, index) => {
          const cat = cats[catId] ?? {};
          const trustArc = cat.trust_arc ?? [];
          const last = trustArc.at(-1) ?? 0;
          const sign = last >= 0 ? '+' : '';

          return (
            <button
              type="button"
              class:list={['cs-tab', { on: index === 0 }]}
              data-cat-tab={catId}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              style={`--cat-accent:${cat.accent ?? 'var(--ink3)'}`}
            >
              <span class="cn">{cat.name ?? catId}</span>
              <span class="ct">{sign}{last}</span>
            </button>
          );
        })}
      </div>

      {order.map((catId, index) => {
        const cat = cats[catId] ?? {};
        const trustArc = cat.trust_arc ?? [];
        const last = trustArc.at(-1) ?? 0;
        const sign = last >= 0 ? '+' : '';
        const accent = cat.accent ?? 'var(--ink3)';
        const bars = cat.bars ?? [];
        const moments = cat.moments ?? [];

        return (
          <div
            class:list={['cs-panel', { on: index === 0 }]}
            data-cat-panel={catId}
            role="tabpanel"
            hidden={index !== 0}
          >
            <div class="cp-grid">
              <div class="cp-card raised">
                <div class="label" style={`color:${accent};margin-bottom:.35rem`}>
                  {cat.name ?? catId}
                </div>
                <div class="cp-arch serif">{cat.archetype ?? 'Relationship profile'}</div>
                <div class="cp-trait">{cat.trait ?? 'No separate trait note was recorded yet.'}</div>
                <div class="cp-status">{cat.status ?? `Trust ended at ${last}.`}</div>
              </div>

              <div class="cp-card raised">
                <div class="label" style="margin-bottom:.6rem">Trust arc · by session</div>
                <svg class="cat-trust-svg" viewBox="0 0 260 104" role="img" aria-label={`Trust arc for ${cat.name ?? catId} across sessions`}>
                  <line x1="8" y1="96" x2="252" y2="96" class="grid-line" />
                  <line x1="8" y1="52" x2="252" y2="52" class="grid-line" />
                  <polyline points={trustPoints(trustArc)} fill="none" stroke={accent} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  {trustArc.map((value, pointIndex) => {
                    const points = trustPoints(trustArc).split(' ')[pointIndex]?.split(',') ?? ['8', '96'];
                    return <circle cx={points[0]} cy={points[1]} r="3.5" fill={accent} />;
                  })}
                  {Array.from({ length: safeSessionCount }, (_, sessionIndex) => {
                    const x = safeSessionCount > 1 ? 8 + sessionIndex * (244 / (safeSessionCount - 1)) : 8;
                    return <text x={x} y="102" text-anchor="middle" class="axis-label">S{sessionIndex + 1}</text>;
                  })}
                </svg>
                <div class="cp-delta">
                  Net: <b>{cat.delta ?? `${sign}${last}`}</b> · Session {safeSessionCount}: <b>{trustArc[safeSessionCount - 1] ?? last}</b>
                </div>
              </div>
            </div>

            <div class="raised cp-bars-card">
              <div class="label" style="margin-bottom:.75rem">Trust signals</div>
              {bars.length ? bars.map(bar => (
                <div class="bar-row">
                  <span class="bar-lbl">{bar.label}</span>
                  <div class="bar-track">
                    <div class="bar-fill" data-value={bar.value} style={`background:${accent};width:${bar.value}%`}></div>
                  </div>
                  <span class="bar-val">{bar.value}%</span>
                </div>
              )) : (
                <p class="tl-empty">No trust signal bars were recorded for {cat.name ?? catId} yet.</p>
              )}
            </div>

            <div class="cp-tl-wrap">
              <div class="label" style="margin-bottom:.75rem">Key moments with {cat.name ?? catId}</div>
              <div class="tl">
                {moments.length ? moments.map(ev => (
                  <div class="tl-item">
                    <div class:list={['tl-dot', { hi: ev.highlight }]}></div>
                    <div class="tl-s label">{ev.session}</div>
                    <div class="tl-e">{ev.event}</div>
                    {ev.milestone && <div class="tl-m">↳ {ev.milestone}</div>}
                  </div>
                )) : (
                  <div class="tl-empty">No separate moments were recorded for {cat.name ?? catId} yet.</div>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </>
  ) : (
    <p class="tl-empty">No per-cat relationship data was recorded yet.</p>
  )}
</div>

<script>
document.querySelectorAll('[data-cat-switcher]').forEach(root => {
  const tabs = root.querySelectorAll('[data-cat-tab]');
  const panels = root.querySelectorAll('[data-cat-panel]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-cat-tab');

      tabs.forEach(item => {
        const isActive = item === tab;
        item.classList.toggle('on', isActive);
        item.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach(panel => {
        const isActive = panel.getAttribute('data-cat-panel') === target;
        panel.classList.toggle('on', isActive);
        panel.toggleAttribute('hidden', !isActive);
      });
    });
  });
});
</script>

<style is:global>
/* tab strip */
.cs-root .cs-tabs {
  display: flex;
  border: 0.5px solid var(--border);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 1.25rem;
  background: var(--surface);
}
.cs-root .cs-tab {
  flex: 1;
  padding: .6rem .4rem;
  text-align: center;
  background: none;
  border: none;
  border-right: 0.5px solid var(--border);
  color: var(--ink2);
  line-height: 1.3;
  min-height: 52px;
  transition: background var(--transition), color var(--transition), box-shadow var(--transition);
  position: relative;
}
.cs-root .cs-tab:last-child { border-right: none; }
.cs-root .cs-tab:hover { background: var(--bg2); color: var(--ink); }
.cs-root .cs-tab.on {
  background: var(--bg2);
  color: var(--ink);
  font-weight: 500;
  box-shadow: inset 0 0 0 999px rgba(255,255,255,.18);
}
.cs-root .cs-tab.on::after {
  content: '';
  position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
  background: var(--cat-accent, var(--ink3));
}
.cs-root .cn { display: block; font-size: 13px; margin-bottom: 1px; }
.cs-root .ct { display: block; font-size: 10px; }

/* panel grid */
.cs-root .cp-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  margin-bottom: 12px;
}
.cs-root .raised {
  background: var(--surface);
  border: 0.5px solid var(--border);
  border-radius: 8px;
  padding: 1rem 1.25rem;
}
.cs-root .cp-arch {
  font-size: 1.1rem; font-weight: 400;
  color: var(--ink); margin-bottom: .35rem;
}
.cs-root .cp-trait {
  font-size: 12px; color: var(--ink2); line-height: 1.7; margin-bottom: .85rem;
}
.cs-root .cp-status {
  font-size: 12px; color: var(--ink2); line-height: 1.7;
  border-top: 0.5px solid var(--border); padding-top: .75rem;
  font-style: italic;
}
.cs-root .cat-trust-svg {
  display: block;
  width: 100%;
  height: 130px;
  overflow: visible;
}
.cs-root .grid-line {
  stroke: var(--border);
  stroke-width: 1;
}
.cs-root .axis-label {
  fill: var(--ink3);
  font-size: 8px;
}
.cs-root .cp-delta { font-size: 11px; color: var(--ink3); margin-top: .6rem; }
.cs-root .cp-delta b { color: var(--ink2); font-weight: 400; }

/* bars */
.cs-root .cp-bars-card { margin-bottom: 1.25rem; }
.cs-root .bar-row { display: flex; align-items: center; gap: 10px; margin: .5rem 0; }
.cs-root .bar-lbl { font-size: 12px; color: var(--ink2); width: 180px; flex-shrink: 0; }
.cs-root .bar-track { flex: 1; height: 3px; background: var(--border); border-radius: 2px; overflow: hidden; }
.cs-root .bar-fill { height: 100%; border-radius: 2px; transition: width 1.1s cubic-bezier(.4,0,.2,1); }
.cs-root .bar-val { font-size: 11px; color: var(--ink3); width: 30px; text-align: right; }

/* timeline inside panel */
.cs-root .tl { padding-left: 1.2rem; position: relative; }
.cs-root .tl::before { content:''; position:absolute; left:.4rem; top:4px; bottom:4px; width:0.5px; background:var(--border); }
.cs-root .tl-item { position: relative; margin-bottom: 1rem; }
.cs-root .tl-dot { position:absolute; left:-.85rem; top:.3rem; width:7px; height:7px; border-radius:50%; border:0.5px solid var(--border-md); background:var(--bg); }
.cs-root .tl-dot.hi { background: var(--ink); border-color: var(--ink); }
.cs-root .tl-s { margin-bottom: .12rem; }
.cs-root .tl-e { font-size: 12px; color: var(--ink2); line-height: 1.65; }
.cs-root .tl-m { font-size: 11px; color: var(--ink2); margin-top: .18rem; font-style: italic; }
.cs-root .tl-empty { font-size: 12px; color: var(--ink3); line-height: 1.65; }

@media (max-width: 640px) {
  .cs-root .cp-grid { grid-template-columns: 1fr; }
  .cs-root .bar-lbl { width: 132px; }
}
</style>
