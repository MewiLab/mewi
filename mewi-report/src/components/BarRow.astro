---
// src/components/BarRow.astro
export interface Props {
  label: string;
  value: number;
  color?: string;
}
const { label, value, color = 'var(--ink3)' } = Astro.props;
---
<div class="bar-row">
  <span class="bar-lbl">{label}</span>
  <div class="bar-track">
    <div class="bar-fill" data-value={value} style={`background:${color}`}></div>
  </div>
  <span class="bar-val">{value}%</span>
</div>

<style>
.bar-row {
  display: flex; align-items: center; gap: 10px;
  margin: .5rem 0;
}
.bar-lbl {
  font-size: 12px; color: var(--ink2);
  width: 180px; flex-shrink: 0;
}
.bar-track {
  flex: 1; height: 3px;
  background: var(--border); border-radius: 2px; overflow: hidden;
}
.bar-fill {
  height: 100%; border-radius: 2px;
  width: 0%;
  transition: width 1.1s cubic-bezier(.4,0,.2,1);
}
.bar-val { font-size: 11px; color: var(--ink3); width: 30px; text-align: right; }
</style>

<script>
// Animate bars when they enter viewport
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      const fill = entry.target.querySelector('.bar-fill') as HTMLElement;
      if (fill) fill.style.width = fill.dataset.value + '%';
      observer.unobserve(entry.target);
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('.bar-row').forEach(el => observer.observe(el));
</script>
