---
// src/components/Timeline.astro
export interface TimelineItem {
  session: string;
  event: string;
  highlight?: boolean;
  milestone?: string | null;
}
export interface Props { items: TimelineItem[]; }
const { items } = Astro.props;
---
<div class="tl">
  {items.map(item => (
    <div class="tl-item">
      <div class={`tl-dot${item.highlight ? ' hi' : ''}`}></div>
      <div class="tl-s label">{item.session}</div>
      <div class="tl-e">{item.event}</div>
      {item.milestone && <div class="tl-m">↳ {item.milestone}</div>}
    </div>
  ))}
</div>

<style>
.tl { padding-left: 1.2rem; position: relative; }
.tl::before {
  content: '';
  position: absolute; left: .4rem; top: 4px; bottom: 4px;
  width: 0.5px; background: var(--border);
}
.tl-item { position: relative; margin-bottom: 1.1rem; }
.tl-dot {
  position: absolute; left: -.85rem; top: .3rem;
  width: 7px; height: 7px; border-radius: 50%;
  border: 0.5px solid var(--border-md);
  background: var(--bg);
}
.tl-dot.hi { background: var(--ink); border-color: var(--ink); }
.tl-s { margin-bottom: .15rem; }
.tl-e { font-size: 12px; color: var(--ink2); line-height: 1.65; }
.tl-m { font-size: 11px; color: var(--ink2); margin-top: .2rem; font-style: italic; }
</style>
