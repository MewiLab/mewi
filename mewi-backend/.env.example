# Copy to backend/.env and fill secrets locally.

# ── App / infra ──────────────────────────────────────────────────────────────
ENV=development
DEBUG=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
REDIS_HOST=localhost
REDIS_PORT=6379
API_SECRET_TOKEN=dev-secret-change-me

# ── LLM selection ────────────────────────────────────────────────────────────
# Switch providers by changing only this value after filling the matching block.
# Supported: openai, ollama, openrouter, groq, anthropic
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# Optional active-provider overrides. Usually leave these empty and use the
# provider-specific blocks below.
# LLM_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=

# OpenAI
OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_API_KEY=
# LLM_OPENAI_BASE_URL=

# Ollama or OpenAI-compatible Ollama gateway
LLM_OLLAMA_MODEL=llama3.1
LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_API_KEY=ollama

# OpenRouter
LLM_OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Anthropic
LLM_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LLM_ANTHROPIC_API_KEY=
# LLM_ANTHROPIC_BASE_URL=

# ── Report ingestion/read gateway ────────────────────────────────────────────
# Local/offline ingestion stores raw session files and does not process them.
# Production SQS mode stores raw sessions in S3 and queues the attachment-report
# Lambda:
#   MEWI_REPORT_PROCESSING_MODE=sqs
#   MEWI_REPORT_RAW_BUCKET=mewi-report-raw-v0
#   MEWI_REPORT_SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<acct>/mewi-report-processing
MEWI_REPORT_PROCESSING_MODE=noop
MEWI_REPORT_READY_THRESHOLD=1
MEWI_REPORT_RAW_BUCKET=
MEWI_REPORT_SQS_QUEUE_URL=

# Read gateway for the Astro report site. Keep this secret backend-only; it signs
# capability JWTs for report links (`sub = user_id`, optional `admin = true`).
# Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MEWI_REPORT_RESULTS_BUCKET=
MEWI_REPORT_READ_JWT_SECRET=

# ── Embeddings ───────────────────────────────────────────────────────────────
# Defaults to OpenAI. If EMBEDDING_API_KEY is empty, the app falls back to
# OPENAI_API_KEY, then the active LLM key.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ── Features ─────────────────────────────────────────────────────────────────
ENABLE_MEMORY_PIPELINE=true
ENABLE_REFLECTION_CYCLE=true
BUFFER_FLUSH_THRESHOLD=10
AGENT_PERSONA=mewi
AGENT_PERSONAS=default:mewi,mewi:mewi,miso:miso,pixie:pixie,haru:haru,ratz:ratz,mao:mao,lioner:lioner,feifei:feifei,yuzu:yuzu,sasha:sasha,slime:slime,kosto:kosto,shoma:shoma,yeti:yeti,yuna:yuna,gugu:gugu

# ── LangSmith ────────────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mewilab
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Graph memory (mem0 + Neo4j) — optional, off by default ───────────────────
# Needs the extra installed: uv sync --extra graph-memory
MEMORY_GRAPH_ENABLED=false
# Neo4j Aura: neo4j+s://<id>.databases.neo4j.io   |   local Docker: bolt://localhost:7687
# Local Docker helper: docker compose --profile graph-memory up neo4j
# The compose default password is mewi-neo4j-dev unless you set MEMORY_NEO4J_PASSWORD.
MEMORY_NEO4J_URL=
MEMORY_NEO4J_USERNAME=neo4j
MEMORY_NEO4J_PASSWORD=
# Direct Postgres DSN for mem0's pgvector vector store (Supabase → Connect → URI)
MEMORY_PGVECTOR_DSN=

# And you can use in docker
# docker compose --profile graph-memory up --build -d 
